{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neko-tauri",
  "version": "0.1.0",
  "identifier": "com.liu.neko-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:48911",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "N.E.K.O",
        "width": 1920,
        "height": 1080,
        "maximized": true,
        "acceptFirstMouse": true,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../.venv": ".venv",
      "../../*.py": ".",
      "../../memory": "memory",
      "../../utils": "utils",
      "../../config": "config",
      "../../templates": "templates"
    }
  }
}